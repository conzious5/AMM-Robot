generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  OWNER
  ADMIN
  PROJECT_MANAGER
}

enum EventReadinessStatus {
  READY
  WAITING_FOR_CONFIRMATION
  AT_RISK
  INCOMPLETE
  CHANGED_SINCE_CONFIRMATION
  CANCELLED
}

enum OperationalAlertStatus {
  OPEN
  RESOLVED
}

enum OperationalTaskStatus {
  NOT_ACTIVE
  OPEN
  DUE_SOON
  OVERDUE
  COMPLETED
  DELETED
  UNKNOWN
}

enum OperationalTaskSource {
  VSCO_API
  VSCO_AUTOMATION_WEBHOOK
  AMM_CALCULATED
  MANUAL_PROJECT_MANAGER
}

enum ProjectManagerNotificationStatus {
  PLANNED
  SENT
  FAILED
  SUPPRESSED
}

enum PersonRole {
  PHOTOGRAPHER
  VIDEOGRAPHER
  BOTH
}

enum PreferredChannel {
  EMAIL
  SMS
  BOTH
}

enum EventStatus {
  SCHEDULED
  CANCELED
  COMPLETED
}

enum AssignmentRole {
  PHOTOGRAPHER
  VIDEOGRAPHER
  ASSISTANT
  OTHER
}

enum AssignmentSource {
  VSCO
  ADMIN
  OVERRIDE
}

enum ConfirmationStatus {
  NOT_READY
  PENDING
  CONFIRMED
  DECLINED
  NEEDS_ATTENTION
  UNREACHABLE
  CANCELED
}

enum Channel {
  EMAIL
  SMS
  SYSTEM
}

enum ActionStatus {
  PLANNED
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELED
  SUPPRESSED
  WAITING_FOR_APPROVAL
}

enum Direction {
  INBOUND
  OUTBOUND
  INTERNAL
}

enum DeliveryStatus {
  PLANNED
  ACCEPTED
  SENT
  DELIVERED
  FAILED
  BOUNCED
  COMPLAINED
  RECEIVED
  SUPPRESSED
}

enum ConversationStatus {
  OPEN
  CLOSED
}

enum SyncStatus {
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
}

model Administrator {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  phone        String?
  passwordHash String
  sessionVersion Int       @default(0)
  role         AdminRole @default(ADMIN)
  active       Boolean   @default(true)
  dailyBriefEnabled Boolean @default(false)
  dailyBriefTime String @default("08:00")
  notificationChannel PreferredChannel @default(EMAIL)
  assignedTasks OperationalTask[] @relation("TaskAdministrator")
  notifications ProjectManagerNotification[]
  dailyBriefs ProjectManagerDailyBrief[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model AuthenticationAttempt {
  id           String   @id @default(cuid())
  identityHash String
  kind         String
  successful   Boolean  @default(false)
  attemptedAt  DateTime @default(now())

  @@index([kind, identityHash, attemptedAt])
  @@index([attemptedAt])
}

model Person {
  id                 String           @id @default(cuid())
  vscoExternalId     String?          @unique
  firstName          String
  lastName           String
  displayName        String
  email              String?
  normalizedEmail    String?          @unique
  phone              String?          @unique
  role               PersonRole
  active             Boolean          @default(true)
  timezone           String           @default("America/Denver")
  preferredChannel   PreferredChannel @default(BOTH)
  smsEligible        Boolean          @default(true)
  emailEligible      Boolean          @default(true)
  paused             Boolean          @default(false)
  notes              String?
  rawProviderPayload Json?
  assignments        Assignment[]
  conversations      Conversation[]
  messages           Message[]
  plannedActions     PlannedAction[]
  operationalAlerts  OperationalAlert[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model Event {
  id                 String          @id @default(cuid())
  vscoEventId        String?         @unique
  vscoJobId          String?
  name               String
  eventType          String          @default("Wedding")
  startsAt           DateTime
  endsAt             DateTime?
  timezone           String
  venueName          String?
  address            String?
  virtualUrl         String?
  status             EventStatus     @default(SCHEDULED)
  canceled           Boolean         @default(false)
  paused             Boolean         @default(false)
  rawProviderPayload Json?
  lastSyncedAt       DateTime?
  readinessStatus    EventReadinessStatus @default(INCOMPLETE)
  readinessReasons   Json?
  readinessCalculatedAt DateTime?
  administrativeUrl  String?
  internalNotes      String?
  assignments        Assignment[]
  plannedActions     PlannedAction[]
  messages           Message[]
  changeHistory      EventChange[]
  operationalTasks   OperationalTask[]
  operationalAlerts  OperationalAlert[]
  projectManagerNotifications ProjectManagerNotification[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}

model WedgewoodContact {
  id                 String   @id @default(cuid())
  sourceKey          String?  @unique
  venueName          String
  contactName        String?
  teamOrRole         String?
  email              String
  active             Boolean  @default(true)
  source             String   @default("MANUAL")
  manuallyEdited     Boolean  @default(false)
  rawProviderPayload Json?
  lastSyncedAt       DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([active, venueName])
  @@index([email])
}

model EventChange {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  field     String
  oldValue  Json?
  newValue  Json?
  source    String
  createdAt DateTime @default(now())
}

model Assignment {
  id                   String              @id @default(cuid())
  eventId              String
  personId             String
  event                Event               @relation(fields: [eventId], references: [id])
  person               Person              @relation(fields: [personId], references: [id])
  role                 AssignmentRole
  source               AssignmentSource
  externalAssignmentId String?             @unique
  active               Boolean             @default(true)
  paused               Boolean             @default(false)
  assignedAt           DateTime            @default(now())
  confirmationStatus   ConfirmationStatus  @default(NOT_READY)
  confirmedAt          DateTime?
  confirmationChannel  Channel?
  declinedAt           DateTime?
  declineReason        String?
  needsAttention       Boolean             @default(false)
  lastReminderAt       DateTime?
  nextReminderAt       DateTime?
  reminderCount        Int                 @default(0)
  internalNotes        String?
  plannedActions       PlannedAction[]
  messages             Message[]
  confirmationTokens   ConfirmationToken[]
  operationalAlerts    OperationalAlert[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@unique([eventId, personId, role])
  @@index([confirmationStatus, active])
}

model ReminderPolicy {
  id              String          @id @default(cuid())
  name            String          @unique
  active          Boolean         @default(true)
  roleFilter      AssignmentRole?
  offsetMinutes   Int
  channel         Channel
  attemptNumber   Int
  honorQuietHours Boolean         @default(true)
  escalate        Boolean         @default(false)
  subjectTemplate String?
  messageTemplate String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model PlannedAction {
  id             String       @id @default(cuid())
  type           String
  eventId        String?
  assignmentId   String?
  personId       String?
  event          Event?       @relation(fields: [eventId], references: [id])
  assignment     Assignment?  @relation(fields: [assignmentId], references: [id])
  person         Person?      @relation(fields: [personId], references: [id])
  channel        Channel
  scheduledFor   DateTime
  status         ActionStatus @default(PLANNED)
  reason         String
  messagePreview String
  subjectPreview String?
  idempotencyKey String       @unique
  jobQueueId     String?
  attemptCount   Int          @default(0)
  lastError      String?
  canceledAt     DateTime?
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status, scheduledFor])
}

model Conversation {
  id             String             @id @default(cuid())
  personId       String
  person         Person             @relation(fields: [personId], references: [id])
  channel        Channel
  status         ConversationStatus @default(OPEN)
  lastMessageAt  DateTime           @default(now())
  needsAttention Boolean            @default(false)
  agentSummary   String?
  messages       Message[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([personId, channel])
}

model Message {
  id                 String         @id @default(cuid())
  conversationId     String
  personId           String
  eventId            String?
  assignmentId       String?
  conversation       Conversation   @relation(fields: [conversationId], references: [id])
  person             Person         @relation(fields: [personId], references: [id])
  event              Event?         @relation(fields: [eventId], references: [id])
  assignment         Assignment?    @relation(fields: [assignmentId], references: [id])
  direction          Direction
  channel            Channel
  provider           String
  providerMessageId  String?        @unique
  sender             String
  recipient          String
  subject            String?
  textContent        String
  htmlContent        String?
  deliveryStatus     DeliveryStatus
  authorType         String
  idempotencyKey     String?        @unique
  sentAt             DateTime?
  deliveredAt        DateTime?
  receivedAt         DateTime?
  failureReason      String?
  rawProviderPayload Json?
  createdAt          DateTime       @default(now())
}

model ConfirmationToken {
  id           String     @id @default(cuid())
  tokenHash    String     @unique
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id])
  expiresAt    DateTime
  usedAt       DateTime?
  revokedAt    DateTime?
  createdAt    DateTime   @default(now())
}

model SyncRun {
  id           String     @id @default(cuid())
  provider     String
  startedAt    DateTime   @default(now())
  completedAt  DateTime?
  status       SyncStatus @default(RUNNING)
  cursor       String?
  itemsFetched Int        @default(0)
  itemsCreated Int        @default(0)
  itemsUpdated Int        @default(0)
  itemsSkipped Int        @default(0)
  itemsFailed  Int        @default(0)
  errorSummary String?
  details      Json?
}

model WebhookEvent {
  id              String    @id @default(cuid())
  provider        String
  providerEventId String
  type            String
  status          String    @default("QUEUED")
  payload         Json
  error           String?
  receivedAt      DateTime  @default(now())
  processedAt     DateTime?

  @@unique([provider, providerEventId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorType  String
  actorId    String?
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model AgentRun {
  id             String   @id @default(cuid())
  conversationId String?
  model          String
  redactedInput  Json
  redactedOutput Json?
  toolCalls      Json?
  status         String
  error          String?
  createdAt      DateTime @default(now())
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model RequiredRoleRule {
  id            String         @id @default(cuid())
  jobType       String
  role          AssignmentRole
  requiredCount Int            @default(1)
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([jobType, role])
}

model OperationalTask {
  id                           String                @id @default(cuid())
  provider                     String
  source                       OperationalTaskSource
  externalTaskId               String?
  externalTaskListId           String?
  eventId                      String?
  event                        Event?                @relation(fields: [eventId], references: [id])
  vscoJobId                    String?
  name                         String
  description                  String?
  workflowStage                String?
  assignedVscoUserId           String?
  assignedLocalAdministratorId String?
  assignedLocalAdministrator   Administrator?        @relation("TaskAdministrator", fields: [assignedLocalAdministratorId], references: [id])
  dueAt                        DateTime?
  completedAt                  DateTime?
  status                       OperationalTaskStatus @default(UNKNOWN)
  priority                     String?
  criticalForReadiness         Boolean               @default(false)
  rawProviderPayload           Json?
  lastSyncedAt                 DateTime?
  createdAt                    DateTime               @default(now())
  updatedAt                    DateTime               @updatedAt

  @@unique([provider, externalTaskId])
  @@index([eventId, status])
  @@index([assignedLocalAdministratorId, status])
}

model OperationalAlert {
  id           String                 @id @default(cuid())
  eventId      String?
  event        Event?                 @relation(fields: [eventId], references: [id])
  assignmentId String?
  assignment   Assignment?            @relation(fields: [assignmentId], references: [id])
  personId     String?
  person       Person?                @relation(fields: [personId], references: [id])
  type         String
  severity     String
  reason       String
  recommendedAction String?
  status       OperationalAlertStatus @default(OPEN)
  deduplicationKey String              @unique
  firstSeenAt  DateTime               @default(now())
  lastSeenAt   DateTime               @default(now())
  resolvedAt   DateTime?
  resolvedById String?
  metadata     Json?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@index([status, severity])
  @@index([eventId, status])
}

model ProviderCapability {
  id         String   @id @default(cuid())
  provider   String
  capability String
  supported  Boolean
  evidence   String
  details    Json?
  checkedAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([provider, capability])
}

model ProjectManagerNotification {
  id              String                           @id @default(cuid())
  administratorId String
  administrator   Administrator                    @relation(fields: [administratorId], references: [id])
  eventId         String?
  event           Event?                           @relation(fields: [eventId], references: [id])
  type            String
  channel         Channel
  subject         String?
  body            String
  status          ProjectManagerNotificationStatus @default(PLANNED)
  deduplicationKey String                          @unique
  providerMessageId String?
  failureReason   String?
  sentAt          DateTime?
  createdAt       DateTime                         @default(now())
  updatedAt       DateTime                         @updatedAt

  @@index([administratorId, status])
}

model ProjectManagerDailyBrief {
  id              String        @id @default(cuid())
  administratorId String
  administrator   Administrator @relation(fields: [administratorId], references: [id])
  periodStart     DateTime
  periodEnd       DateTime
  deduplicationKey String       @unique
  subject         String
  body            String
  status          String
  providerMessageId String?
  sentAt          DateTime?
  createdAt       DateTime      @default(now())
}
